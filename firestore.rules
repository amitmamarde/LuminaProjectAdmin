rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is an authenticated Admin
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    // Helper function to check if the user is an authenticated Expert
    function isExpert() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Expert';
    }

    // --- NEW: Rules for the trainingData collection ---
    // --- Rules for the trainingData collection ---
    // Allow Admins to create documents in the trainingData collection.
    match /trainingData/{docId} {
      allow create: if isAdmin();
      // Allow admins to read and list training data.
      allow list, read: if isAdmin();
      // No one should read/update/delete these directly for now.
      allow read, update, delete: if false;
    }

    // Rules for the articles collection
    match /articles/{articleId} {
      // ANYONE can read a published article.
      allow get: if resource.data.status == 'Published';
      
      // AUTHENTICATED users can list/read articles based on their role.
      allow list: if request.auth != null || isAdmin() || resource.data.status == 'Published';

      // ADMINS have full control to create and delete.
      allow create, delete: if isAdmin();

      // --- UPDATED: Broadened update rule ---
      // This allows Admins to perform any update (including setting status to 'Archived').
      // It also allows Experts to update articles specifically assigned to them.
      allow update: if isAdmin() || 
                     (isExpert() && resource.data.expertId == request.auth.uid);
    }

    // Rules for user profiles
    match /users/{userId} {
      // Any authenticated user can read profile data (e.g., to see an expert's name).
      allow list: if isAdmin();

      allow read: if request.auth != null;
      // Only the user themselves or an Admin can update a profile.
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // Only Admins can create or delete user docs.
      allow create, delete: if isAdmin();
    }
    
    // Rules for source test reports (and their subcollections)
    match /sourceTestReports/{reportId}/{document=**} {
        allow read, write: if isAdmin();
    }

    // Rules for suggested topics
    match /suggested_topics/{suggestionId} {
      // Only Admins can read the topic suggestions and delete them (approve/reject).
      allow read, delete: if isAdmin();
    }
  }
}
